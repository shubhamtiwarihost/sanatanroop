# Hostinger LiteSpeed / Apache configuration for SanatanRoop Next.js Static Export
# Force Default Charset to UTF-8
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .txt

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"

  # Redirect www to non-www (HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.sanatanroop\.com$ [NC]
  RewriteRule ^(.*)$ https://sanatanroop.com/$1 [L,R=301]

  # Pass the Authorization header to PHP (needed for the PhonePe webhook)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Protected e-book download
  RewriteRule ^download/book/([^/]+)/?$ /api/download.php?book=$1 [QSA,L]

  # Admin-written posts for the sitemap
  RewriteRule ^sitemap-posts\.xml$ /api/sitemap-posts.php [L]

  # PDF proxy for the book reader (archive.org blocks direct browser fetches); never compress the stream
  RewriteRule ^api/pdf/?$ /api/pdf.php [QSA,L,E=no-gzip:1]

  # E-book product pages are rendered by one viewer page that reads the name from the URL
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/ebooks/$1/index.html !-f
  RewriteRule ^ebooks/([^/]+)/?$ /ebooks/view/index.html [L]

  # Books added in the admin have no pre-built page: serve the library page, which opens the book from the URL
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/books/$1/index.html !-f
  RewriteRule ^books/([^/]+)/?$ /books/index.html [L]

  # Posts written in the admin have no pre-built page: serve the post viewer, which reads the slug from the URL
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1/$2/index.html !-f
  RewriteRule ^(articles|blog)/([^/]+)/?$ /api/post.php?slug=$2 [QSA,L]

  # Force trailing slash for existing directories
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ $1/ [L,R=301]

  # Serve .html file if direct match exists (single or multi-level path)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Serve index.html inside directory if exists
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 404 Error Document
  ErrorDocument 404 /404.html
</IfModule>

# Gzip / Deflate Compression for Speed and Core Web Vitals
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom+xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/truetype
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# Long-term Cache Headers for Next.js Static Chunks
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|svg|webp|jpg|jpeg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Content-Type "text/html; charset=UTF-8"
  </FilesMatch>
  <FilesMatch "\.txt$">
    Header set Content-Type "text/plain; charset=UTF-8"
  </FilesMatch>
</IfModule>

# Browser Caching via mod_expires
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
